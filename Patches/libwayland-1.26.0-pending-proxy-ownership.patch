+/* Constructor ownership transfers only when an installed callback is invoked. */
+static void
+destroy_unclaimed_proxies(struct wl_closure *closure)
+{
+	const char *signature = closure->message->signature;
+	struct argument_details arg;
+	struct wl_proxy *proxy;
+	int i, count = arg_count_for_signature(signature);
+
+	for (i = 0; i < count; i++) {
+		signature = get_next_argument(signature, &arg);
+		if (arg.type != WL_ARG_NEW_ID)
+			continue;
+		proxy = (struct wl_proxy *) closure->args[i].o;
+		if (!proxy || !(proxy->flags & WL_PROXY_FLAG_UNCLAIMED))
+			continue;
+		proxy->flags &= ~WL_PROXY_FLAG_UNCLAIMED;
+		if (!(proxy->flags & WL_PROXY_FLAG_DESTROYED))
+			wl_proxy_destroy_caller_locks(proxy);
+	}
+}
+
+static void
+claim_constructor_proxies(struct wl_closure *closure)
+{
+	const char *signature = closure->message->signature;
+	struct argument_details arg;
+	struct wl_proxy *proxy;
+	int i, count = arg_count_for_signature(signature);
+
+	for (i = 0; i < count; i++) {
+		signature = get_next_argument(signature, &arg);
+		if (arg.type != WL_ARG_NEW_ID)
+			continue;
+		proxy = (struct wl_proxy *) closure->args[i].o;
+		if (proxy)
+			proxy->flags &= ~WL_PROXY_FLAG_UNCLAIMED;
 	}
 }
 
